[Unit]
Description=Census Calculator
After=systemd-networkd.service frontend-network.service

[Container]
Image=localhost/census-calculator:latest
ContainerName=census-calculator
Network=frontend.network
Volume={DATA_DIR}/census-calculator/Cutoffs.ods:/app/Cutoffs.ods:ro
#PublishPort=8080:8000

[Service]
Restart=always

[Install]
WantedBy=default.target
