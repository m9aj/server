[Unit]
Description=HortusFox MariaDB Database
After=systemd-networkd.service backend-network.service

[Container]
Image=docker.io/mariadb:latest
ContainerName=hortusfox_db
Network=backend.network
Volume={DATA_DIR}/hortusfox/db:/var/lib/mysql:Z
Environment=MARIADB_DATABASE=hortusfox
Environment=MARIADB_USER=hortusfox
Secret=hortusfox_db_root_password,type=env,target=MARIADB_ROOT_PASSWORD
Secret=hortusfox_db_password,type=env,target=MARIADB_PASSWORD

[Service]
Restart=always

[Install]
WantedBy=default.target
