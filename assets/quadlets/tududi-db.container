[Unit]
Description=Tududi Postgres Database
After=systemd-networkd.service backend-network.service

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=tududi_db
Network=backend.network
Volume={DATA_DIR}/tududi/postgres:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=tududi
Environment=POSTGRES_USER=tududi
Secret=tududi_db_password,type=env,target=POSTGRES_PASSWORD

[Service]
Restart=always

[Install]
WantedBy=default.target
