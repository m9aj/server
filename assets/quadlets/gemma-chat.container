[Unit]
Description=Gemma Chat Local Workspace
After=systemd-networkd.service frontend-network.service ollama.service
Requires=ollama.service

[Container]
Image=localhost/gemma-chat:latest
ContainerName=gemma-chat
Network=frontend.network
Environment=OLLAMA_URL=http://ollama:11434

[Service]
Restart=always

[Install]
WantedBy=default.target
